# Configure these values for your isolated Wayfinder deployment.
# The application reads the process environment; do not commit a populated .env.
THUNDERID_BASE_URL=
THUNDERID_CA_FILE=
AGENT_ID=
AGENT_SECRET=
MCP_SERVER_URL=
# Exact registered URI used by the frontend's consent popup.
AGENT_REDIRECT_URI=
# Resource-server identifier for this agent's protected /chat endpoint.
AGENT_CHAT_URL=
FRONTEND_ORIGIN=
HOST=127.0.0.1
# PORT or AGENT_PORT must match AGENT_CHAT_URL's port.
AGENT_PORT=
AGENT_ACCESS_SCOPE=agent:access

LLM_PROVIDER=google
LLM_API_KEY=
MODEL_NAME=

# Optional CIBA upgrade processor, using a separate registered client.
UPGRADE_SCHEDULER_ENABLED=false
UPGRADE_AGENT_ID=
UPGRADE_AGENT_SECRET=
CIBA_HINT_TYPE=login_hint
