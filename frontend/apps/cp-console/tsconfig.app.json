{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path Aliases — reuse the Data Plane console's source in full. */
    "paths": {
      "@console/*": ["../console/src/*"],
      "@/*": ["../console/src/*"],
      "@/components/*": ["../console/src/components/*"],
      "@/layouts/*": ["../console/src/layouts/*"],
      "@/theme/*": ["../console/src/theme/*"],
      "@/contexts/*": ["../console/src/contexts/*"],
      "@/lib/*": ["../console/src/lib/*"],
      "@/hooks/*": ["../console/src/hooks/*"],
      "@/types/*": ["../console/src/types/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*", "src/vite-env.d.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"]
}
