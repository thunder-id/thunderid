{
  "private": true,
  "name": "@thunderid/configure-import-export",
  "version": "0.0.0",
  "description": "Import/export configuration feature for ⚡️ ThunderID applications",
  "keywords": [
    "thunderid",
    "configure",
    "import-export",
    "react",
    "feature"
  ],
  "homepage": "https://github.com/thunder-id/thunderid/tree/main/frontend/packages/configure-import-export#readme",
  "bugs": {
    "url": "https://github.com/thunder-id/thunderid/issues"
  },
  "author": "The ThunderID Authors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
