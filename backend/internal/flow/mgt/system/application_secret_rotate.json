{
  "id": "019a1f40-6a1c-7000-8000-5e5713d00002",
  "handle": "system-application-secret-rotate",
  "name": "Application client secret rotation",
  "flowType": "SYSTEM",
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "onSuccess": "validate_secret_regeneration"
    },
    {
      "id": "validate_secret_regeneration",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "ApplicationActionValidator",
        "mode": "revoke_before_action"
      },
      "onSuccess": "revoke_tokens"
    },
    {
      "id": "revoke_tokens",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "CriteriaRevocationExecutor",
        "mode": "revoke"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "END"
    }
  ]
}
