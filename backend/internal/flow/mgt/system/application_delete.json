{
  "id": "019a1f40-6a1c-7000-8000-5e5713d00001",
  "handle": "system-application-delete",
  "name": "Application deletion",
  "flowType": "SYSTEM",
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "onSuccess": "validate_application_deletion"
    },
    {
      "id": "validate_application_deletion",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "ApplicationActionValidator",
        "mode": "revoke_all"
      },
      "onSuccess": "revoke_tokens"
    },
    {
      "id": "revoke_tokens",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "CriteriaRevocationExecutor",
        "mode": "revoke"
      },
      "onSuccess": "revoke_sessions"
    },
    {
      "id": "revoke_sessions",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "SessionRevocationExecutor"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "END"
    }
  ]
}
