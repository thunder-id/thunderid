# Quickstart release image: the auth-dp, managed Data Plane and Control Plane of the quickstart
# pack, already wired together, in one container. The release pipeline packages the quickstart
# archives first (see Dockerfile.release for the Data Plane image); this only unpacks the one for
# the target architecture. The build context is a directory of Linux quickstart archives plus
# quickstart-entrypoint.sh. The three planes share one container because the pack wires them
# together over localhost and one set of key material.
# Unpack the target architecture's archive, on the build platform to avoid emulation.
FROM --platform=$BUILDPLATFORM alpine:3.23 AS dist

ARG TARGETARCH

RUN apk add --no-cache unzip

WORKDIR /dist

COPY thunderid-[0-9]*-linux-*.zip ./

RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) archive_arch=x64 ;; \
      arm64) archive_arch=arm64 ;; \
      *) echo "unsupported target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    archive="$(ls thunderid-[0-9]*-linux-"$archive_arch".zip)"; \
    unzip -q "$archive" -d /extracted; \
    mkdir -p /opt/thunderid-quickstart; \
    cp -r /extracted/thunderid-[0-9]*/. /opt/thunderid-quickstart/

# Listen on every interface so the published ports reach the planes. The pack's own URLs, and the
# certificate it generates, stay on localhost, which is where the published ports are reached from.
RUN set -eux; \
    cd /opt/thunderid-quickstart; \
    for plane in auth-dp:8091 dp:8090 cp:8095; do \
      dir="${plane%%:*}"; port="${plane##*:}"; \
      sed -i 's/hostname: "localhost"/hostname: "0.0.0.0"/' "$dir/deployment.yaml"; \
      sed -i "/hostname: \"0.0.0.0\"/a\\  public_url: \"https://localhost:$port\"" "$dir/deployment.yaml"; \
    done

# Security material (TLS/JWT/AES keys) is not baked into the image; the setup step generates it per deployment.

# Runtime stage
FROM alpine:3.23

RUN apk add --no-cache --upgrade \
    ca-certificates \
    ca-certificates-bundle \
    lsof \
    sqlite \
    bash \
    curl \
    openssl \
    unzip

RUN addgroup -S thunderid -g 10001 && adduser -S thunderid -u 10001 -G thunderid

WORKDIR /opt/thunderid-quickstart

# The pack root holds the setup marker, which the non-root user writes.
RUN chown thunderid:thunderid /opt/thunderid-quickstart

COPY --from=dist --chown=thunderid:thunderid /opt/thunderid-quickstart /opt/thunderid-quickstart
COPY --chown=thunderid:thunderid quickstart-entrypoint.sh /usr/local/bin/quickstart-entrypoint.sh

RUN chmod +x /usr/local/bin/quickstart-entrypoint.sh setup.sh start.sh quickstart-bootstrap.sh \
      auth-dp/thunderid auth-dp/start.sh auth-dp/setup.sh auth-dp/scripts/init_script.sh \
      dp/thunderid dp/start.sh dp/setup.sh dp/scripts/init_script.sh \
      cp/thunderid-cp cp/start-cp.sh cp/setup-cp.sh cp/scripts/init_script.sh && \
    (find . -path '*/bootstrap/*.sh' -type f -exec chmod +x {} \; 2>/dev/null || true)

EXPOSE 8090 8091 8095

USER thunderid

ENTRYPOINT ["quickstart-entrypoint.sh"]
