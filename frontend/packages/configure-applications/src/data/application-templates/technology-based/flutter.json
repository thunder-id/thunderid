  "capabilities": {
    "attestation": true
  },
  "integrationGuides": {
    "REDIRECT_BASED": {
      "llm_prompt": {
        "docsUrl": "{{applications.templates.flutter.llmPrompt.redirectBased}}"
      }
    }
  }
