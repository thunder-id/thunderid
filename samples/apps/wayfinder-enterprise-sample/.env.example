## Copy this file to .env.local. Values without NEXT_PUBLIC_ are read only on the server.

# The ThunderID server, and the application the declarative import creates.
NEXT_PUBLIC_THUNDERID_BASE_URL=https://localhost:8090
NEXT_PUBLIC_THUNDERID_CLIENT_ID=WAYFINDER_ENTERPRISE
THUNDERID_CLIENT_SECRET=wayfinder-enterprise-secret
NEXT_PUBLIC_THUNDERID_APPLICATION_ID=019f0a10-0000-7000-8000-000000000031
NEXT_PUBLIC_THUNDERID_AFTER_SIGN_IN_URL=http://localhost:3000
NEXT_PUBLIC_THUNDERID_AFTER_SIGN_OUT_URL=http://localhost:3000
NEXT_PUBLIC_THUNDERID_SCOPES=openid profile email roles ou booking:view booking:create booking:manage policy:view policy:manage user:view user:manage group:view group:manage role:view role:manage sso:view sso:manage

# Encrypts the session cookie. Use a long random string.
THUNDERID_SECRET=replace-with-a-long-random-string

# Where the app runs. The admin components reach the backend routes under /api/admin from here.
WAYFINDER_APP_URL=http://localhost:3000

# The resource server whose permissions the app requests.
WAYFINDER_API_RESOURCE=urn:wayfinder-enterprise:api

# Resources the declarative import creates with fixed IDs.
WAYFINDER_SIGN_IN_FLOW_ID=019f0a10-0000-7000-8000-000000000021
WAYFINDER_ADMIN_ROLE_ID=019f0a10-0000-7000-8000-000000000011
WAYFINDER_MEMBER_ROLE_ID=019f0a10-0000-7000-8000-000000000012
WAYFINDER_ADMIN_ROLE_NAME=Wayfinder Admin
WAYFINDER_USER_TYPE=wayfinder-user

# The backend client that calls the root-only management APIs on a company admin's behalf, and the
# resource server that holds the root "system" permission. The app gets the client's token at the
# admin's company's token endpoint (/ou/{ouId}/oauth2/token), so each token names that company.
WAYFINDER_BACKEND_CLIENT_ID=WAYFINDER_ENTERPRISE_BACKEND
WAYFINDER_BACKEND_CLIENT_SECRET=wayfinder-enterprise-backend-secret
THUNDERID_SYSTEM_RESOURCE=https://localhost:8090/mcp
