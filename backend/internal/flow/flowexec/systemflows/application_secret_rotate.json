{
  "operation": "application.secret_rotate",
  "exposure": "internal",
  "flow": {
    "id": "system-flow:application.secret_rotate",
    "handle": "system-application-secret-rotate",
    "name": "Application client secret rotation",
    "flowType": "SYSTEM",
    "nodes": [
      {"id": "start", "type": "START", "onSuccess": "plan"},
      {
        "id": "plan",
        "type": "TASK_EXECUTION",
        "executor": {"name": "ApplicationActionValidator", "mode": "revoke_before_action"},
        "onSuccess": "revoke_tokens"
      },
      {
        "id": "revoke_tokens",
        "type": "TASK_EXECUTION",
        "executor": {"name": "CriteriaRevocationExecutor"},
        "onSuccess": "end"
      },
      {"id": "end", "type": "END"}
    ]
  }
}
