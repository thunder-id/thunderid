          "height": 113
        },
        "position": {
          "x": 2120,
          "y": 442
        }
      },
      "executor": {
        "name": "AuthAssertExecutor"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "END",
      "layout": {
        "size": {
          "width": 85,
          "height": 34
        },
        "position": {
          "x": 2500,
          "y": 482
        }
      }
