{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["FRONTEND_BUILD_RUNTIME"],
      "outputs": ["dist/**", "build/**", "modules/**"]
    },
    "@thunderid/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"],
      "env": ["DOCUSAURUS_URL", "DOCUSAURUS_BASE_URL"]
    },
    "@thunderid/console#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "src/data/sample-bundles/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "env": ["FRONTEND_TEST_RUNTIME"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "CI"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
