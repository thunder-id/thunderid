{
  "id": "019a1f40-6a1c-7000-8000-5e5713d00011",
  "handle": "system-user-credential-update-pre",
  "name": "User credential update, before the change",
  "flowType": "SYSTEM",
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "onSuccess": "pre_credential_update"
    },
    {
      "id": "pre_credential_update",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "PreCredentialUpdateExecutor",
        "mode": "revoke_before_action"
      },
      "onSuccess": "revoke_tokens"
    },
    {
      "id": "revoke_tokens",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "CriteriaRevocationExecutor",
        "mode": "revoke"
      },
      "onSuccess": "revoke_sessions"
    },
    {
      "id": "revoke_sessions",
      "type": "TASK_EXECUTION",
      "executor": {
        "name": "SessionRevocationExecutor"
      },
      "onSuccess": "end"
    },
    {
      "id": "end",
      "type": "END"
    }
  ]
}
